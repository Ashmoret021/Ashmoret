{
  "schema": {
    "name": "scenario_management",
    "tables": {
      "scenario": {
        "description": "טבלת התרחישים.",
        "fields": {
          "id": {
            "type": "string",
            "primary_key": true,
            "nullable": false,
            "description": "מזהה ייחודי לתרחיש"
          },
          "name": {
            "type": "string",
            "nullable": false,
            "description": "שם התרחיש"
          },
          "drones_group_id": {
            "type": "integer",
            "nullable": false,
            "foreign_key": {
              "table": "drones_group",
              "field": "id"
            },
            "description": "קבוצת הרחפנים של התרחיש"
          },
          "launchers_group_id": {
            "type": "integer",
            "nullable": false,
            "foreign_key": {
              "table": "launchers_group",
              "field": "id"
            },
            "description": "קבוצת המשגרים של התרחיש"
          },
          "type": {
            "type": "string",
            "nullable": false,
            "description": "סוג התרחיש: חד זירתי או רב זירתי"
          }
        }
      },

      "drones_group": {
        "description": "קבוצת רחפנים המשויכת לתרחיש.",
        "fields": {
          "id": {
            "type": "integer",
            "primary_key": true,
            "nullable": false,
            "description": "מזהה ייחודי של קבוצת הרחפנים"
          },
          "name": {
            "type": "string",
            "nullable": false,
            "description": "שם קבוצת הרחפנים"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "תיאור קבוצת הרחפנים"
          }
        }
      },

      "launchers_group": {
        "description": "קבוצת משגרים המשויכת לתרחיש.",
        "fields": {
          "id": {
            "type": "integer",
            "primary_key": true,
            "nullable": false,
            "description": "מזהה ייחודי של קבוצת המשגרים"
          },
          "name": {
            "type": "string",
            "nullable": false,
            "description": "שם קבוצת המשגרים"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "תיאור קבוצת המשגרים"
          }
        }
      },

      "drone": {
        "description": "רחפנים השייכים לקבוצת רחפנים.",
        "fields": {
          "id": {
            "type": "integer",
            "primary_key": true,
            "nullable": false,
            "description": "מזהה ייחודי לרחפן"
          },
          "drones_group_id": {
            "type": "integer",
            "nullable": false,
            "foreign_key": {
              "table": "drones_group",
              "field": "id"
            },
            "description": "קבוצת הרחפנים שאליה הרחפן שייך"
          },
          "longitude": {
            "type": "number",
            "nullable": false,
            "description": "קו האורך של הרחפן"
          },
          "latitude": {
            "type": "number",
            "nullable": false,
            "description": "קו הרוחב של הרחפן"
          },
          "asl": {
            "type": "number",
            "nullable": false,
            "description": "גובה הרחפן מעל פני הים"
          },
          "agl": {
            "type": "number",
            "nullable": false,
            "description": "גובה הרחפן מעל הקרקע"
          },
          "heading": {
            "type": "number",
            "nullable": false,
            "description": "כיוון התנועה של הרחפן"
          },
          "velocity": {
            "type": "number",
            "nullable": false,
            "description": "מהירות הרחפן"
          },
          "type": {
            "type": "integer",
            "nullable": false,
            "foreign_key": {
              "table": "drone_type",
              "field": "id"
            },
            "description": "סוג הרחפן"
          }
        }
      },

      "launcher": {
        "description": "משגרים השייכים לקבוצת משגרים.",
        "fields": {
          "id": {
            "type": "integer",
            "primary_key": true,
            "nullable": false,
            "description": "מזהה ייחודי למשגר"
          },
          "launchers_group_id": {
            "type": "integer",
            "nullable": false,
            "foreign_key": {
              "table": "launchers_group",
              "field": "id"
            },
            "description": "קבוצת המשגרים שאליה המשגר שייך"
          },
          "longitude": {
            "type": "number",
            "nullable": false,
            "description": "קו האורך של המשגר"
          },
          "latitude": {
            "type": "number",
            "nullable": false,
            "description": "קו הרוחב של המשגר"
          },
          "asl": {
            "type": "number",
            "nullable": false,
            "description": "גובה המשגר מעל פני הים"
          },
          "agl": {
            "type": "number",
            "nullable": false,
            "description": "גובה המשגר מעל הקרקע"
          },
          "type": {
            "type": "integer",
            "nullable": false,
            "foreign_key": {
              "table": "launcher_type",
              "field": "id"
            },
            "description": "סוג המשגר"
          },
          "amount": {
            "type": "integer",
            "nullable": false,
            "description": "כמות המשגרים"
          },
          "active": {
            "type": "boolean",
            "nullable": false,
            "description": "האם המשגר פעיל"
          }
        }
      },

      "launcher_ammunition": {
        "description": "טבלת התחמושת של המשגרים, המגדירה את סוג וכמות המיירטים הזמינים בכל משגר.",
        "fields": {
          "launcher_id": {
            "type": "integer",
            "primary_key": true,
            "nullable": false,
            "foreign_key": {
              "table": "launcher",
              "field": "id"
            },
            "description": "מזהה המשגר"
          },
          "interceptor_type_id": {
            "type": "integer",
            "primary_key": true,
            "nullable": false,
            "foreign_key": {
              "table": "interceptor_type",
              "field": "id"
            },
            "description": "סוג המיירט"
          },
          "amount": {
            "type": "integer",
            "nullable": false,
            "description": "כמות המיירטים מסוג זה"
          }
        }
      },

      "drone_type": {
        "description": "טבלה סטטית של סוגי הרחפנים.",
        "fields": {
          "id": {
            "type": "integer",
            "primary_key": true,
            "nullable": false,
            "description": "מזהה סוג הרחפן"
          },
          "name": {
            "type": "string",
            "nullable": false,
            "unique": true,
            "description": "שם סוג הרחפן"
          }
        }
      },

      "interceptor_type": {
        "description": "טבלה סטטית של סוגי המיירטים.",
        "fields": {
          "id": {
            "type": "integer",
            "primary_key": true,
            "nullable": false,
            "description": "מזהה סוג המיירט"
          },
          "name": {
            "type": "string",
            "nullable": false,
            "unique": true,
            "description": "שם סוג המיירט"
          }
        }
      },

      "launcher_type": {
        "description": "טבלה סטטית של סוגי המשגרים.",
        "fields": {
          "id": {
            "type": "integer",
            "primary_key": true,
            "nullable": false,
            "description": "מזהה סוג המשגר"
          },
          "name": {
            "type": "string",
            "nullable": false,
            "unique": true,
            "description": "שם סוג המשגר"
          },
          "reload_time": {
            "type": "number",
            "nullable": false,
            "description": "זמן הטעינה של המשגר"
          }
        }
      }
    },

    "relationships": [
      {
        "from": "scenario.id",
        "to": "drones_group.id",
        "type": "many_to_one"
      },
      {
        "from": "scenario.id",
        "to": "launchers_group.id",
        "type": "many_to_one"
      },
      {
        "from": "drones_group.id",
        "to": "drone.drones_group_id",
        "type": "one_to_many"
      },
      {
        "from": "launchers_group.id",
        "to": "launcher.launchers_group_id",
        "type": "one_to_many"
      },
      {
        "from": "drone_type.id",
        "to": "drone.type",
        "type": "one_to_many"
      },
      {
        "from": "launcher_type.id",
        "to": "launcher.type",
        "type": "one_to_many"
      },
      {
        "from": "launcher.id",
        "to": "launcher_ammunition.launcher_id",
        "type": "one_to_many"
      },
      {
        "from": "interceptor_type.id",
        "to": "launcher_ammunition.interceptor_type_id",
        "type": "one_to_many"
      }
    ]
  }
}
